[Unit]
Description=Bumperbot teleoperation via bluetooth joystick
OnFailure=bluetooth_joy_teleop_failure.service
Requires=bumperbot.target
BindsTo=bluetooth-radio.service bluetooth_joy_connect.service joy_teleop.service

After=bumperbot.target
After=bluetooth-radio.service bluetooth_joy_connect.service joy_teleop.service

[Install]
WantedBy=multi-user.target
